include(FetchContent)
# Reviewed MIT source, fixed revision and archive digest. No runtime source downloads.
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(LLAMA_BUILD_COMMON OFF CACHE BOOL "" FORCE)
set(LLAMA_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(LLAMA_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(LLAMA_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LLAMA_BUILD_SERVER OFF CACHE BOOL "" FORCE)
set(LLAMA_CURL OFF CACHE BOOL "" FORCE)
set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
set(GGML_LLAMAFILE OFF CACHE BOOL "" FORCE)
FetchContent_Declare(leo_llama
    URL https://codeload.github.com/ggml-org/llama.cpp/tar.gz/a7a98e0fffed794396b3fbad4dcdbbc184963645
    URL_HASH SHA256=4d78e6aa4a9124b58dff994416525294fbab2990fe905a640d4cbd26bf563a31)
FetchContent_MakeAvailable(leo_llama)
add_library(leo_llama_jni SHARED leo_llama_jni.cpp)
target_compile_features(leo_llama_jni PRIVATE cxx_std_17)
target_link_libraries(leo_llama_jni PRIVATE llama)
if(ANDROID)
    target_link_libraries(leo_llama_jni PRIVATE c++_shared)
    target_link_options(leo_llama_jni PRIVATE "-Wl,--no-undefined" "-Wl,-z,max-page-size=16384")
else()
    find_path(JAVA_INCLUDE_PATH jni.h HINTS "$ENV{JAVA_HOME}/include" REQUIRED)
    find_path(JAVA_INCLUDE_PATH2 jni_md.h HINTS "${JAVA_INCLUDE_PATH}/linux" "${JAVA_INCLUDE_PATH}/win32" "${JAVA_INCLUDE_PATH}/darwin" REQUIRED)
    target_include_directories(leo_llama_jni PRIVATE ${JAVA_INCLUDE_PATH} ${JAVA_INCLUDE_PATH2})
endif()
